const products = [
  { title: "Phone", price: 500, inStock: true },
  { title: "Laptop", price: 1200, inStock: false },
  { title: "Mouse", price: 25, inStock: true },
  { title: "Monitor", price: 300, inStock: true },
];

// 1. Hamma mahsulotlarning umumiy narxi
const totalPrice = products.reduce((sum, product) => sum + product.price, 0);
console.log(totalPrice); // 2025

// 2. Omborda bor mahsulotlarning umumiy narxi
const inStockTotal = products
  .filter((product) => product.inStock)
  .reduce((sum, product) => sum + product.price, 0);
console.log(inStockTotal); // 825

// 3. Narx bo'yicha arzondan qimmatga (asl massiv o'zgarmaydi)
const sortedByPrice = [...products].sort((a, b) => a.price - b.price);
console.log(sortedByPrice);
// Mouse (25), Monitor (300), Phone (500), Laptop (1200)

// 4. 10% chegirma, butun obyekt saqlanadi
const discounted = products.map((product) => ({
  ...product,
  price: product.price * 0.9,
}));
console.log(discounted);
// Phone 450, Laptop 1080, Mouse 22.5, Monitor 270

// 5. Hamma nomlar bitta matn
const names = products.map((product) => product.title).join(", ");
console.log(names); // "Phone, Laptop, Mouse, Monitor"







